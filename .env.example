# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing secret for unified Web & Android authentication tokens.
JWT_SECRET="change-this-to-a-long-random-secret"

# Optional Supabase / PostgreSQL configuration for external cloud persistence
# Leave blank to use the built-in SQLite database (./data/aistudio.db)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""

# Optional Cloud Storage (S3 / Supabase Storage)
STORAGE_BUCKET="aistudio-media"
